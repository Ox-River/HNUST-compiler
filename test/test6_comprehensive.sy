// 测试6: 综合测试
// 涵盖多种语言特性的综合使用

// 阶乘函数（递归）
int factorial(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

// 斐波那契数列第n项（迭代）
int fibonacci(int n) {
    int a;
    int b;
    int temp;
    int i;

    if (n <= 1) {
        return n;
    }

    a = 0;
    b = 1;
    i = 2;

    while (i <= n) {
        temp = a + b;
        a = b;
        b = temp;
        i = i + 1;
    }

    return b;
}

int main() {
    int f5;
    int fib10;
    float pi;
    int i;

    f5 = factorial(5);
    print(f5);     // 120

    fib10 = fibonacci(10);
    print(fib10);  // 55

    // 浮点数运算
    pi = 3.14;
    print(pi);

    // 计算1*1 + 2*2 + ... + 5*5
    i = 1;
    f5 = 0;
    while (i <= 5) {
        f5 = f5 + i * i;
        i = i + 1;
    }
    print(f5);     // 55

    return 0;
}
